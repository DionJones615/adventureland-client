{
  "name": "adventureland-client",
  "version": "1.0.0",
  "private": true,
  "description": "Adventure Land protocol client and bot runner, with loop scripts that can be mounted into the container",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "npm run test:unit",
    "test:unit": "node --test test/unit/*.test.mjs",
    "test:e2e": "node --test test/e2e/*.test.mjs",
    "e2e:up": "node scripts/e2e/container.mjs up",
    "e2e:down": "node scripts/e2e/container.mjs down",
    "e2e:status": "node scripts/e2e/container.mjs status",
    "e2e:logs": "node scripts/e2e/container.mjs logs",
    "bot": "node scripts/bot.mjs",
    "watch": "node scripts/watch.mjs",
    "fetch-data": "node scripts/fetch_game_data.mjs",
    "fetch-reference": "node scripts/fetch_reference.mjs"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "socket.io-client": "^4.8.3"
  }
}
