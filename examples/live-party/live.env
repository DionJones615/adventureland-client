# The 24/7 profile: the same gates as live.env.example, and no credentials in the file
# (the systemd unit passes them in through EnvironmentFile).
#
#   node scripts/live/service.mjs --env examples/live-party/live.env --live
#
AL_API=https://adventure.land
AL_SERVER=EU I
AL_PARTY_ROLES=Dion6=leader,Maion=fighter,Paion=priest,DionMerchant=merchant
AL_PARTY_ANCHOR=-193,780
AL_PARTY_SELL_AT=-193,680
#
# Only goos, only our own loot, never gift, never sell: a long run has no supervisor for the bag.
AL_PARTY_TARGETS=goo
AL_PARTY_SEND=off
AL_PARTY_SELL=off
AL_PARTY_OWN_LOOT=1
#
# A long run expects to die now and then: -1 means never stop for a death.
AL_PARTY_MAX_DEATHS=-1
AL_PARTY_SECONDS=0
AL_PUBLISH=http://127.0.0.1:7899
