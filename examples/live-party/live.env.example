# The live profile: a real account, a real server, and the gates that keep it timid.
#
# Copy to live.env and fill in the two credentials. Nothing here is committed with a password in it.
#
#   npm run live:party -- --env examples/live-party/live.env --live --seconds 300
#
# One login, four sockets: the launcher logs in once and shares the session.
AL_USERNAME=
AL_PASSWORD=
#
# Everyone has to play on the same server. The name is the region and the server, as the game lists it.
AL_API=https://adventure.land
AL_SERVER=EU I
#
# Who plays what. The leader owns the party; the merchant cannot fight and should not.
AL_PARTY_ROLES=Dion6=leader,Maion=fighter,Paion=priest,DionMerchant=merchant
#
# Where the party hunts: the goo field of main, 100 units from the standmerchant NPC at (-193,680).
# The anchor is also the loot/send radius centre (B.dist 400) and inside sell range.
AL_PARTY_ANCHOR=-193,780
AL_PARTY_SELL_AT=-193,680
#
# Safety gates, all on by default for this file:
#   * only goos are attacked (the weakest spawn in that field, hp 100);
#   * nothing is handed to the merchant, because a fighter's bag holds more than loot;
#   * nothing is sold, because the live sell path is unverified and rarity is not recoverable;
#   * a loot pile is opened only within 2.5 s of one of our own kills.
AL_PARTY_TARGETS=goo
AL_PARTY_SEND=off
AL_PARTY_SELL=off
AL_PARTY_OWN_LOOT=1
#
# Stop the whole party after this many respawns instead of feeding a death loop.
AL_PARTY_MAX_DEATHS=3
AL_PARTY_SECONDS=0
#
# The local relay the watch page reads from (npm run live:relay in this repository).
AL_PUBLISH=http://127.0.0.1:7899
