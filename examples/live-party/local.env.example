# The same party, against a throwaway stack on this machine. No real account, no real server.
#
#   npm run live:party -- --env examples/live-party/local.env --api http://127.0.0.1:18090
#
# The party stack of examples/party (npm run e2e:up) seeds four characters on this account.
AL_API=http://127.0.0.1:18090
AL_USERNAME=party@example.test
AL_PASSWORD=party-password-123
#
# The container needs the service address: the stack advertises its own localhost:7192.
AL_GAME_ADDRESS=127.0.0.1:17192
#
AL_PARTY_ROLES=PartyTank=leader,PartyMage=fighter,PartyPriest=priest,PartyMerch=merchant
AL_PARTY_ANCHOR=-100,800
AL_PARTY_SELL_AT=-193,680
#
# Locally the full party behaviour is the point: nothing is gated off.
AL_PARTY_SEND=on
AL_PARTY_SELL=on
AL_PARTY_MAX_DEATHS=10
AL_PARTY_SECONDS=0
AL_PUBLISH=http://127.0.0.1:7899
