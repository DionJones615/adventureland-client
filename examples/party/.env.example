# Copy to .env (next to this file) and edit. Every value here is the built-in default, so the
# example runs without a .env at all.

# The account the game container creates and all four clients log into.
AL_PARTY_EMAIL=party@example.test
AL_PARTY_PASSWORD=party-password-123

# Host ports. Deliberately not 8090/7192, so the party stack can live next to another stack.
AL_PARTY_API_PORT=18090
AL_PARTY_GAME_PORT=17192

# Image pins. Pin sha-<short> tags for reproducible runs.
AL_GAME_IMAGE=ghcr.io/dionjones615/adventureland-container:latest
AL_CLIENT_IMAGE=ghcr.io/dionjones615/adventureland-client:latest

# Leave the stack's maps merchant-less (upstream default). Nothing in the party can sell then.
# AL_TEST_MERCHANT=off
